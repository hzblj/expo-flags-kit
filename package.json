{
  "name": "@hzblj/expo-flags-kit",
  "version": "0.1.0",
  "description": "Country flags for Expo as a native vector view on iOS and Android, with web support. FlagKit artwork, sharp at any size.",
  "author": "Jan Blazej",
  "license": "MIT",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./expo-module.config.json": "./expo-module.config.json",
    "./package.json": "./package.json"
  },
  "files": [
    "android/build.gradle",
    "android/src/**",
    "assets/flags",
    "build",
    "expo-module.config.json",
    "flagkit/LICENSE",
    "ios"
  ],
  "keywords": [
    "country",
    "country-flags",
    "emoji",
    "expo",
    "expo-module",
    "flag",
    "flagkit",
    "flags",
    "react-native",
    "svg",
    "vector"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzblj/expo-flags-kit.git"
  },
  "bugs": {
    "url": "https://github.com/hzblj/expo-flags-kit/issues"
  },
  "homepage": "https://github.com/hzblj/expo-flags-kit#readme",
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.build.json",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "flags:generate": "tsx scripts/generate.ts",
    "flags:verify": "tsx scripts/verify.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepack": "yarn build",
    "release": "changeset publish",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "expo": ">=57",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@hzblj/biome-config": "^0.2.1",
    "@types/node": "^22.19.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.2.14",
    "@xmldom/xmldom": "^0.9.12",
    "expo": "~57.0.30",
    "pngjs": "^7.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "svgpath": "^2.6.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "yarn@4.18.0"
}
