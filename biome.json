{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "extends": [
    "@hzblj/biome-config",
    "@hzblj/biome-config/react-native"
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/build",
      "!**/node_modules",
      "!android/src/main/res",
      "!assets",
      "!flagkit",
      "!ios/Flags.xcassets"
    ]
  },
  "overrides": [
    {
      "includes": [
        "example/metro.config.js"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off"
          },
          "style": {
            "noCommonJs": "off"
          }
        }
      }
    }
  ]
}
